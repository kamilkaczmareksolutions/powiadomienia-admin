# Gmail API (Service Account with domain-wide delegation)
SERVICE_ACCOUNT_FILE=/app/oauth2service.json
IMPERSONATED_USER=your-user@your-domain.com
GROUP_ADDRESS=admin@your-domain.com

# ClickUp
CLICKUP_API_KEY=pk_your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_workspace_id
CLICKUP_CHANNEL_ID=your_channel_id

# Bot settings
CHECK_INTERVAL=60
LOG_LEVEL=INFO
FLASK_PORT=8080
HEARTBEAT_TIMEOUT_SECONDS=300
